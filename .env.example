# Base URL of the SmartCattle FastAPI backend (no trailing slash needed).
# Production: VITE_API_BASE_URL=https://your-backend-domain.example
VITE_API_BASE_URL=http://localhost:8000
# Data source: api | mock | hybrid
#   mock   - everything is demo data; the backend is never contacted, and
#            sign-in uses the demo accounts kept in this browser
#   hybrid - the backend provides what it can; the rest is labeled demo data
#   api    - backend only; capabilities without an endpoint show as unavailable
#
# AUTHENTICATION IS NOT DEMO DATA. In hybrid and api alike, signing in goes to
# the backend. It used to fall back to the demo accounts in hybrid, which meant
# the deployed app authenticated against unsalted SHA-256 hashes in
# localStorage. A session that is not real cannot protect anything and looks
# exactly like one that is, so only `mock` keeps the demo accounts.
VITE_DATA_SOURCE=hybrid
# Never put secrets here (AI_API_KEY, passwords, tokens): VITE_* values are public in the browser bundle.
# Local AI service (live.py in the YOLO repo) that serves the camera video and its detections.
# Runs on the PC next to the camera. Empty = no live video.
VITE_AI_SERVICE_URL=http://localhost:8090
